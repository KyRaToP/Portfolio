# Portfolio frontend — example environment variables (Vite)
# Copy to `.env` and fill values manually. Do not commit real secrets.
#
# Note: standard name is `.env.example` (not `.env_example`).
# This is a mostly static site; secrets are usually unnecessary.
# Only variables prefixed with VITE_ are exposed to client code.

# Public site origin (optional; useful for absolute OG/canonical URLs later)
VITE_SITE_URL=https://example.com

# Optional analytics / third-party public keys (placeholders only)
# VITE_ANALYTICS_ID=
